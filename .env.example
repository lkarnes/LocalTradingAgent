OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_LIGHTWEIGHT_MODEL=qwen3:1.7b
OLLAMA_CONTEXT_SIZE=4096
OLLAMA_TEMPERATURE=0
OLLAMA_TIMEOUT=300
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=24h
OLLAMA_MAX_LOADED_MODELS=1
MAX_AI_CALLS_PER_SCAN=2
AI_REVIEW_CACHE_MINUTES=30

PAPER_TRADING=true
LIVE_TRADING_ENABLED=false
REQUIRE_MANUAL_APPROVAL=true
TRADING_MODE=research

PAPER_INITIAL_CAPITAL=5000
PAPER_COMMISSION_PER_ORDER=0
PAPER_SLIPPAGE_BPS=10
PAPER_MINIMUM_DAYS=30
PAPER_REQUIRE_MINIMUM_TRADES=20

BROKER_PROVIDER=none
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
MARKET_DATA_PROVIDER=yfinance
NEWS_PROVIDER=rss
FINNHUB_API_KEY=
SEC_USER_AGENT=LocalTradingAgent contact@example.com
COST_GUARD_ENABLED=true
ALLOW_PAID_PROVIDERS=false

ANALYSIS_INTERVAL_MINUTES=60
NEWS_INTERVAL_MINUTES=15
TRADE_EVALUATION_INTERVAL_MINUTES=60
RISK_PROFILE=balanced
NOTIFICATIONS_ENABLED=false
NOTIFICATIONS_TELEGRAM_ENABLED=false
